---
import SiteLayout from "../layouts/SiteLayout.astro";
import Section from "../components/ui/Section.astro";
import ScrollButton from "../components/ui/ScrollButton.astro";
import PanelGrid from "../components/PanelGrid.astro";
import BackLink from "../components/ui/BackLink.astro";
import { panels2027 as panels } from "../data/archive/2027/panels";

const panelCountText = ["a panel", "two panels", "three panels", "four panels"][panels.length - 1] ?? `${panels.length} panels`;
const panelBackgrounds = ["#00bcae", "#87a5ad"];
---
<SiteLayout title="Panels" description="Panels for Careers in Quantum.">
  <ScrollButton/>
    <section class="topbar" data-conditional-topbar hidden>
      <BackLink
        defaultHref="/schedule"
        defaultLabel="← Back to Schedule"
        fromParam="from"
        fromValue="panels"
      />
    </section>
  <Section background="hsl(192, 100%, 15%)" padding="0rem 1.5rem" maxWidth="900px">
    <main class="hero-content">
      <center>
        <h1>Panels</h1>
        {panels.length === 0 ? (
          <p>Panels for this year's Careers in Quantum will be announced soon.</p>
        ) : (
          <>
            <p>For this year's Careers in Quantum, we are hosting {panelCountText} with a range of exciting speakers.</p>
            {panels.map((panel, i) => (
              <>
                <div class="actions">
                  <a href={`#panel${i + 1}`} class="btn">Panel {i + 1}: {panel.title}</a>
                </div>
                <p>{panel.description}</p>
              </>
            ))}
          </>
        )}
      </center>
    </main>
  </Section>

  {panels.map((panel, i) => (
    <section class="panel" id={`panel${i + 1}`} style={`background-color: ${panelBackgrounds[i % panelBackgrounds.length]};`}>
      <div class="inner">
        <h2>Panel {i + 1}: {panel.title}</h2>
        <PanelGrid speakers={panel.speakers} />
      </div>
    </section>
  ))}

<script is:inline>
  (function() {
    const handleTopbar = () => {
      const bar = document.querySelector("[data-conditional-topbar]");
      const panels = document.querySelectorAll(".panel"); // Select the panels
      
      if (!bar) return;

      const params = new URLSearchParams(window.location.search);
      const fromValue = params.get("from")?.toLowerCase();

      if (fromValue === "schedule") {
        bar.removeAttribute('hidden');
        bar.style.display = 'block';

        // CRITICAL: Add the attribute so the CSS scroll-margin-top kicks in
        panels.forEach(panel => {
          panel.setAttribute('data-has-topbar', '');
        });

        // Setup the Back Button inside the topbar
        // This assumes your BackLink component renders an <a> or <button>
        const backBtn = bar.querySelector('a, button');
        if (backBtn) {
          backBtn.onclick = (e) => {
            e.preventDefault();
            window.history.back();
          };
        }
      }
    };

    // Run on load and transitions
    document.addEventListener('DOMContentLoaded', handleTopbar);
    document.addEventListener('astro:page-load', handleTopbar);
    handleTopbar();
  })();
</script>

  <style>
  /* 1. Make the Topbar Sticky */
    .topbar {
      position: sticky; /* Not fixed! */
      top: 0;           /* Where it "catches" */
      left: 0;
      width: 100%;
      z-index: 1000;
      background-color: hsl(192, 100%, 15%);
      padding: 1rem 1.5rem;
      display: none;    /* Managed by JS */
    }

    .topbar:not([hidden]) {
      display: block;
    }

  /* Target elements by ID that have the data attribute assigned by JS */
    .panel[data-has-topbar] {
      scroll-margin-top: 70px !important; /* Start with 100px; 300px is huge! */
    }

    html {
        scroll-behavior: smooth;
      }

    @media (max-width: 768px) {
      .topbar[hidden] {
        display: none;
      }
    }
    .hero-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: center;
      padding: 2rem 0;
    }

    .actions {
      display: grid;
      gap: 1rem;
      margin-top: 1.25rem;
      justify-items: center;
    }

    .actions .btn {
      margin: 0;
    }

    .panel {
      padding: 4rem 1.5rem;
    }
    @media (max-width: 768px) {
      .panel {
        padding: 2rem 1.5rem;
      }
    }

    .inner {
      max-width: 900px;
      margin: 0 auto;
    }
  </style>
</SiteLayout>
