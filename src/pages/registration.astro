---
import SiteLayout from "../layouts/SiteLayout.astro";
import Section from "../components/ui/Section.astro";
---

<SiteLayout title="Registration" description="Registration for Careers in Quantum.">
  <Section background="hsl(192, 100%, 15%)" padding="2rem 1.5rem" maxWidth="900px">
    <center>
    <h1>Registration</h1>
    <p>
      Careers in Quantum is a free event, but registration is required.
      <br/>
  </p>
    <h5>Registration for Careers in Quantum 2027 will open soon.</h5>
    <p>
      Details of travel bursaries will be shared when registration opens. Please check back here for updates.
    </p>
    </center>
  </Section>
</SiteLayout>
