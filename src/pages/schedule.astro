---
import SiteLayout from "../layouts/SiteLayout.astro";
import Section from "../components/ui/Section.astro";
import ScrollButton from "../components/ui/ScrollButton.astro";
import ScheduleGrid from "../components/Schedule.astro";
import { schedule2027 as schedule } from "../data/archive/2027/schedule.ts";

// Set to the programme PDF's path in public/ (e.g. "/schedule/schedule.pdf") once it's ready.
const programmePdf: string | undefined = undefined;
---
<SiteLayout title="Schedule" description="Event schedule for Careers in Quantum.">
  <ScrollButton/>
  <Section background="hsl(192, 100%, 15%)" padding="0rem 1.5rem" maxWidth="900px">
    <main class="hero-content">
      <center>
        <h1>Schedule</h1>
      </center>
      {schedule.length === 0 ? (
        <p>The schedule for this year's Careers in Quantum will be announced soon.</p>
      ) : programmePdf && (
        <p>Click <a href={programmePdf} download>here</a> to download a digital version of the programme (note that abstracts and bios are abridged).</p>
      )}
    </main>
  </Section>

  {schedule.length > 0 && (
    <section class="schedule">
        <div class="scheduleMargin">
          <ScheduleGrid days={schedule} />
        </div>
    </section>
  )}

  <style>
    .hero-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: center;
      padding: 2rem 0;
    }

    .actions {
      display: grid;
      justify-items: center;
      margin-top: 1.25rem;
    }

    .schedule {
      background-color: #00bcae;
      /* Use a responsive padding strategy */
      padding: 2rem 1.5rem 4rem; 
    }

    /* Desktop-only: add the large side margins */
    @media (min-width: 1100px) {
      .schedule {
        padding-left: calc(10% + 2rem);
        padding-right: calc(10% + 2rem);
      }
    }

    .scheduleMargin {
      max-width: 1100px;
      margin: 0 auto; /* Centers the schedule on desktop */
    }

    @media (max-width: 700px) {
      .schedule {
        padding: 1.5rem 0.75rem 3rem; /* Tighter padding for small phones */
      }
      .scheduleMargin {
        margin: 0;
      }
    }
  </style>
</SiteLayout>
